# Copy to .env on the server. Never commit the real file.
API_SECRET=replace-with-a-long-random-secret
PORT=4310
DATABASE_URL=postgresql://user:password@postgres.example.internal:5432/xingzhou
COS_BUCKET=replace-me
COS_REGION=ap-singapore
COS_SECRET_ID=replace-me
COS_SECRET_KEY=replace-me
# Enable only after checking the host reaches this bucket over the same-region
# internal network. Stores disposable 640px previews; never changes COS originals.
COS_PREVIEW_ENABLED=0
COS_PREVIEW_CACHE_DIR=/opt/xingzhou-cloud-backend/var/image-previews
# Local per-minute action/count/byte totals, without users, prompts or tokens.
TRAFFIC_METRICS_ENABLED=0
