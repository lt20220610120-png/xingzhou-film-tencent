{
  "name": "xingzhou-film-tencent",
  "productName": "行舟影视（腾讯云版）",
  "version": "2.8.150",
  "description": "行舟影视：剧本、导演、项目协作与 AI 影像生产工作台",
  "author": "行舟影视",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/test.cjs",
    "build": "vite build --configLoader runner",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run test && npm run build && node scripts/package-release.cjs",
    "release": "npm run dist && python scripts/publish_release.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "mammoth": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "pngjs": "^7.0.0",
    "wait-on": "latest"
  },
  "build": {
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "appId": "com.xingzhou.film.tencent",
    "productName": "Xingzhou Film Tencent Edition",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "cloud-backend/shared/**/*",
      "cloud-backend/src/storyboard-merge.cjs",
      "cloud-backend/src/storyboard-settings.cjs",
      "cloud-backend/src/storyboard-identity.cjs",
      "cloud-backend/src/prompt-duration.cjs",
      "cloud-backend/src/collab-episodes.cjs",
      "cloud-backend/src/director-source.cjs",
      "cloud-backend/src/episode-identity-repair.cjs",
      "cloud-backend/src/image-composition.cjs",
      "cloud-backend/src/reference-upload-delete.cjs",
      "cloud-backend/src/art-review-repository.cjs",
      "cloud-backend/src/analysis-publication.cjs",
      "canvas-app/**/*",
      "browser-extension/**/*",
      "build/icon.ico",
      "package.json",
      "world-simulation/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Xingzhou-Film-Tencent-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xingzhou Film Tencent"
    }
  }
}
